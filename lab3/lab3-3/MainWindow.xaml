<Window x:Class="lab3_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналіз масиву" Height="500" Width="800" Background="#FAFAFA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
            <TextBlock Text="Введіть кількість елементів n:" VerticalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="InputN" Width="80" Margin="10,0,0,0" FontSize="16"/>
            <Button Content="Згенерувати масив" Click="GenerateArray_Click" Margin="20,0,0,0" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Початковий масив:" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="OriginalArrayText" TextWrapping="Wrap" Margin="0,5,0,10" FontSize="14"/>

            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,10"/>

            <TextBlock Text="Масив після реверсу:" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="ReversedArrayText" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Обробити масив" Click="ProcessArray_Click"
                HorizontalAlignment="Right" Width="200" Height="40" FontSize="16" Margin="0,20,0,0"/>
    </Grid>
</Window>
