<Window x:Class="lab2_1_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2_1_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="txtX" HorizontalAlignment="Left" Margin="176,63,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFECB67F"/>
        <TextBox x:Name="txtZ" HorizontalAlignment="Left" Margin="176,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFECB67F"/>
        <TextBox x:Name="txtY" HorizontalAlignment="Left" Margin="176,139,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.508,4.791" Background="#FFECB67F"/>
        <Button Content="Calculate" HorizontalAlignment="Center" Margin="0,127,0,0" VerticalAlignment="Top" Click="Button_Click" Background="#FFF98A1A" Height="50" Width="108"/>
        <TextBox x:Name="txtRes" HorizontalAlignment="Left" Margin="346,217,0,0" TextWrapping="Wrap" Text="Result" VerticalAlignment="Top" Width="120" Background="#FFECB67F"/>
        <Label Content="enter x" HorizontalAlignment="Left" Margin="99,59,0,0" VerticalAlignment="Top"/>
        <Label Content="enter z" HorizontalAlignment="Left" Margin="99,213,0,0" VerticalAlignment="Top"/>
        <Label Content="enter  y" HorizontalAlignment="Left" Margin="99,135,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
